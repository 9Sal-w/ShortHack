# =============================================================
# Файл переменных окружения backend'а.
# Скопируйте в ".env" (без .example) и заполните реальными значениями.
# ".env" НЕ должен попадать в git — там хранится секретный API-ключ ИИ.
# =============================================================

# ---- Общие настройки сервера ----
APP_HOST=0.0.0.0
APP_PORT=8080
JWT_SECRET=change-me-to-a-long-random-secret-string
JWT_EXPIRE_MINUTES=480

# ---- Учётные данные оператора ----
OPERATOR_LOGIN=admin
OPERATOR_PASSWORD=admin
OPERATOR_DISPLAY_NAME=Оператор поддержки

# ---- База данных ----
DATABASE_URL=sqlite:///./sbertech_support.db

# =============================================================
# ---- ИИ-провайдер: Yandex Cloud (YandexGPT) ----
# =============================================================
# AI_PROVIDER: "yandexgpt" | "mock"
AI_PROVIDER=yandexgpt

# Статический API-ключ сервисного аккаунта (рекомендуется для сервера)
YANDEX_API_KEY=PASTE_YOUR_YANDEX_CLOUD_API_KEY_HERE

# Альтернатива — IAM-токен (живёт 12 часов, нужно периодически обновлять)
YANDEX_IAM_TOKEN=

# Folder ID каталога Yandex Cloud, где создан сервисный аккаунт
YANDEX_FOLDER_ID=PASTE_YOUR_YANDEX_CLOUD_FOLDER_ID_HERE

# Модель YandexGPT: yandexgpt-lite, yandexgpt, yandexgpt-32k
YANDEX_GPT_MODEL=yandexgpt-lite

# Температура генерации отдельно для каждого агента (0.0-1.0)
YANDEX_INTAKE_TEMPERATURE=0.2
YANDEX_REWRITE_TEMPERATURE=0.4
